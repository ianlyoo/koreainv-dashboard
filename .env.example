APP_KEY=
APP_SECRET=
URL_BASE=https://openapi.koreainvestment.com:9443
CANO=
ACNT_PRDT_CD=01
TRADE_MODE=live
PAPER_URL_BASE=https://openapivts.koreainvestment.com:29443
COOKIE_SECURE=false

# Optional read-only Toss proxy (keep real values in the private .env only)
TOSS_PROXY_SERVER_ENABLED=false
